# Application
NODE_ENV=development
PORT=3001
APP_NAME=RowSentry

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rowsentry
DB_USER=rowsentry_user
DB_PASSWORD=changeme
DB_MAX_POOL=10
DB_SSL=false

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret-at-least-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
